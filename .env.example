# Скопируйте в .env и подставьте значения. Файл .env в git не коммитится.

# --- HTTP-сервис ---
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info,onec_assistant=debug

# --- Пользователи и роли ---
USERS_FILE=users.toml

# --- Журнал ---
AUDIT_DB_PATH=audit.sqlite
# false: текст вопроса в журнал не пишется
LOG_QUESTIONS=true

# --- Языковая модель ---
# openai_compatible | yandexgpt | gigachat
LLM_BACKEND=openai_compatible
# Базовый URL. Если не задан, берётся умолчание провайдера:
#   openai_compatible: http://127.0.0.1:8080/v1 (до /chat/completions)
#   yandexgpt:         https://ai.api.cloud.yandex.net/foundationModels/v1 (до /completion)
#   gigachat:          https://api.giga.chat/v1 (до /chat/completions)
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Модель. Умолчания: local-model | yandexgpt/latest | GigaChat-2-Pro
# Для yandexgpt можно указать полный URI: gpt://<каталог>/<модель>
LLM_MODEL=local-model
# openai_compatible: Bearer-ключ (необязательно)
# yandexgpt: API-ключ сервисного аккаунта (заголовок Authorization: Api-Key)
# gigachat: ключ авторизации из личного кабинета (Basic), по нему получается токен
LLM_API_KEY=
LLM_TIMEOUT_SECS=60
# yandexgpt: от 0 до 1; gigachat: 0 означает «не передавать» (значение модели)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
# yandexgpt: идентификатор каталога (modelUri и заголовок x-folder-id)
LLM_FOLDER_ID=
# gigachat: GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Дополнительные корневые сертификаты (PEM), например НУЦ Минцифры для GigaChat
LLM_CA_CERT_PATH=

# --- 1С ---
# mock | http
ONEC_BACKEND=mock
ONEC_BASE_URL=http://1c.local/base
ONEC_USER=assistant_ro
ONEC_PASSWORD=
ONEC_TIMEOUT_SECS=10
# Эндпоинты условные: контракт HTTP-сервиса 1С ещё не согласован
ONEC_PATH_SEARCH_COUNTERPARTY=/hs/assistant/counterparties
ONEC_PATH_COUNTERPARTY_BALANCE=/hs/assistant/balance
ONEC_PATH_ACCOUNT_TURNOVER=/hs/assistant/turnover
ONEC_PATH_UNPAID_INVOICES=/hs/assistant/unpaid-invoices

# --- Лимиты оркестратора ---
MAX_ITERATIONS=5
MAX_TOOL_CALLS_PER_ITERATION=4
REQUEST_TIMEOUT_SECS=60
MAX_MESSAGE_CHARS=4000
