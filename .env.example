# Скопируйте в .env и подставьте значения. Файл .env в git не коммитится.

# --- HTTP-сервис ---
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info,onec_assistant=debug

# --- Пользователи и роли ---
USERS_FILE=users.toml

# --- Журнал ---
AUDIT_DB_PATH=audit.sqlite
# false: текст вопроса в журнал не пишется
LOG_QUESTIONS=true

# --- Языковая модель ---
# openai_compatible | yandexgpt | gigachat  (yandexgpt и gigachat пока заготовки)
LLM_BACKEND=openai_compatible
# Для llama-server / vLLM: базовый URL до /v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
# Необязательно: для локального llama-server ключ обычно не нужен
LLM_API_KEY=
LLM_TIMEOUT_SECS=60
LLM_TEMPERATURE=0

# --- 1С ---
# mock | http
ONEC_BACKEND=mock
ONEC_BASE_URL=http://1c.local/base
ONEC_USER=assistant_ro
ONEC_PASSWORD=
ONEC_TIMEOUT_SECS=10
# Эндпоинты условные: контракт HTTP-сервиса 1С ещё не согласован
ONEC_PATH_SEARCH_COUNTERPARTY=/hs/assistant/counterparties
ONEC_PATH_COUNTERPARTY_BALANCE=/hs/assistant/balance
ONEC_PATH_ACCOUNT_TURNOVER=/hs/assistant/turnover
ONEC_PATH_UNPAID_INVOICES=/hs/assistant/unpaid-invoices

# --- Лимиты оркестратора ---
MAX_ITERATIONS=5
MAX_TOOL_CALLS_PER_ITERATION=4
REQUEST_TIMEOUT_SECS=60
MAX_MESSAGE_CHARS=4000
